# Root-owned 0640 environment file read by systemd. Do not put camera passwords
# or any Telegram/LTE credentials here.
EDGEWATCH_DEVICE_ID=satellite-001
EDGEWATCH_CAMERA_ID=cam1

# Local camera substream only. Userinfo is forbidden in this URL.
MEDIA_RTSP_CAM1_URL=rtsp://192.168.40.10:554/h264Preview_01_sub
MEDIA_RTSP_CAM1_CREDENTIALS_FILE=/etc/edgewatch/camera-cam1.json

# The credential file is owned by edgewatch-camera, mode 0600, and contains
# exactly: {"username":"local-camera-user","password":"..."}

# Every active directory is immutable and signed; current is an atomic symlink
# to one immediate child of releases.
EDGEWATCH_MODEL_RELEASES_ROOT=/opt/edgewatch/models/releases
EDGEWATCH_RELEASES_ROOT=/opt/edgewatch/releases
EDGEWATCH_CURRENT_SYMLINK=/opt/edgewatch/current
EDGEWATCH_MODEL_CURRENT_SYMLINK=/opt/edgewatch/models/current
EDGEWATCH_MODEL_KEYRING_DIR=/etc/edgewatch/model-keys
EDGEWATCH_HARDWARE_MODEL=raspberry-pi-zero-2
EDGEWATCH_MODEL_LITERT_VERSION=2.1.6

# Evidence is always local-only. Age is fixed at 30 days; this byte ceiling is
# the second eviction limit and should be sized for the installed SD card.
EDGEWATCH_SATELLITE_EVIDENCE_DIR=/var/lib/edgewatch-media/evidence
EDGEWATCH_SATELLITE_EVIDENCE_MAX_BYTES=8589934592

# Atomic mode-0600 handoff files for the MCU/LoRa bridge and readiness checks.
EDGEWATCH_SATELLITE_RESULT_PATH=/var/lib/edgewatch-camera-satellite/result.json
EDGEWATCH_SATELLITE_READY_PATH=/var/lib/edgewatch-camera-satellite/ready.json
EDGEWATCH_SATELLITE_GATE_STATE_PATH=/var/lib/edgewatch-camera-satellite/alert-gate.json
EDGEWATCH_SATELLITE_LOCK_PATH=/run/edgewatch-camera-satellite/run.lock
EDGEWATCH_SATELLITE_POWEROFF_REQUEST_PATH=/run/edgewatch-camera-satellite/poweroff.request
EDGEWATCH_SATELLITE_READINESS_TTL_S=300

# shadow is the safe default. live additionally requires the private promotion
# evidence file described below; the runner validates >=95% precision and <=1
# false alert per device-day before enabling alerts.
EDGEWATCH_INFERENCE_MODE=shadow
# EDGEWATCH_INFERENCE_PROMOTION_FILE=/etc/edgewatch/inference-promotion.json

# The optional promotion file is owned by edgewatch-camera, mode 0600, and has:
# {"schema_version":1,"held_out_alert_precision":0.95,"false_alert_count":7,"device_days":14}

EDGEWATCH_EVENT_REASON=sentinel_event
EDGEWATCH_SATELLITE_CAPTURE_TIMEOUT_S=35
EDGEWATCH_SATELLITE_EVENT_DURATION_S=10
EDGEWATCH_SATELLITE_PREPROCESS_TIMEOUT_S=20
EDGEWATCH_FFMPEG_BINARY=ffmpeg
EDGEWATCH_FFPROBE_BINARY=ffprobe
