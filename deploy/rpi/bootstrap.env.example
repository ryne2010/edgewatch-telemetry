# Bootstrap bundle for first-boot provisioning.
#
# Copy this to /boot/firmware/edgewatch/bootstrap.env on the SD card.
# Do not commit real secrets.

# Required bootstrap values
BOOTSTRAP_PROFILE=standalone
BOOTSTRAP_IMAGE_PROFILE_PATH=/etc/edgewatch-image-profile
BOOTSTRAP_REPO_DIR=/opt/edgewatch/app

# fleet-image-v1 creates this locked, passwordless-sudo account with
# public-key-only SSH. Provisioning supplies exactly one public key; no private
# key or authorized key is baked into the reusable image.
BOOTSTRAP_SSH_USER=ryne
BOOTSTRAP_SSH_AUTHORIZED_KEY_FILE=/boot/firmware/edgewatch/authorized_key
# A separate controller key is forced through the typed device-control helper;
# it cannot request an arbitrary shell, PTY, or port forwarding.
BOOTSTRAP_CONTROL_SSH_AUTHORIZED_KEY_FILE=/boot/firmware/edgewatch/control_authorized_key

# Fleet OTA trust anchor (public key only; the signing private key never goes
# onto an SD card or device).
BOOTSTRAP_OTA_PUBLIC_KEY_FILE=/boot/firmware/edgewatch/ota_keys/edgewatch-release.pem
BOOTSTRAP_OTA_PUBLIC_KEY_ID=edgewatch-release

# Optional application-bundle replacement. fleet-image-v1 already contains the
# stable app; when set, bootstrap verifies, stages, and atomically activates the
# downloaded replacement.
# BOOTSTRAP_BUNDLE_URI=https://example.com/edgewatch-bundle.tar.gz
# BOOTSTRAP_BUNDLE_SHA256=<sha256-hex>
# BOOTSTRAP_BUNDLE_SIGNATURE=<base64-signature>
# BOOTSTRAP_BUNDLE_SIGNATURE_SCHEME=openssl_rsa_sha256
# BOOTSTRAP_BUNDLE_SIGNATURE_KEY_ID=edgewatch-release
# BOOTSTRAP_BUNDLE_KEYRING_DIR=/boot/firmware/edgewatch/keyring
# BOOTSTRAP_BUNDLE_INSTALL_DIR=/opt/edgewatch/app
# BOOTSTRAP_BUNDLE_STRIP_COMPONENTS=1

# Required agent identity and exclusive telemetry transport.
EDGEWATCH_DEVICE_ID=rpi-001
EDGEWATCH_TELEMETRY_TRANSPORT=telegram

# Telegram-first fleet provisioning. Put the token in the separate boot file;
# bootstrap copies it to TELEGRAM_BOT_TOKEN_FILE with mode 0600 and deletes the
# boot-partition source after a successful import.
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_BOT_TOKEN_FILE=/var/lib/edgewatch/telegram_bot_token
BOOTSTRAP_TELEGRAM_BOT_TOKEN_FILE=/boot/firmware/edgewatch/telegram_bot_token
# Inline fallback; this value is redacted from bootstrap.env after success.
# BOOTSTRAP_TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# API alternative (set EDGEWATCH_TELEMETRY_TRANSPORT=api).
# EDGEWATCH_API_URL=https://YOUR-INGEST-URL
# EDGEWATCH_DEVICE_TOKEN=PASTE_DEVICE_TOKEN_HERE
SENSOR_BACKEND=none

# Local cadence, durable buffering, and daily cost controls.
SAMPLE_INTERVAL_S=600
ALERT_SAMPLE_INTERVAL_S=600
HEARTBEAT_INTERVAL_S=3600
BUFFER_MAX_POINTS=5000
BUFFER_MAX_AGE_S=604800
BUFFER_MAX_DB_BYTES=104857600
MAX_BYTES_PER_DAY=5000000
EDGEWATCH_COST_CAP_URGENT_RESERVE_BYTES=262144
TELEGRAM_BATCH_ENABLED=true
TELEGRAM_BATCH_MAX_POINTS=100
TELEGRAM_BATCH_MAX_BYTES=1000000
TELEGRAM_BATCH_MAX_AGE_S=3600
BUFFER_SQLITE_SYNCHRONOUS=FULL

# Common local defaults
RUNTIME_POWER_MODE=continuous
DEEP_SLEEP_BACKEND=auto
EDGEWATCH_ALLOW_REMOTE_SHUTDOWN=0
EDGEWATCH_ENABLE_OTA_APPLY=0
EDGEWATCH_RUNTIME_DEPENDENCY_PATH=/opt/edgewatch/current/agent/requirements.txt
EDGEWATCH_OTA_POWER_EVIDENCE_MAX_AGE_S=300

# Cellular observability uses persisted actual wwan counters for the daily byte
# budget when available. The active link watchdog remains opt-in.
CELLULAR_METRICS_ENABLED=true
CELLULAR_WATCHDOG_ENABLED=false
CELLULAR_INTERFACE=wwan0
# Bootstrap derives CELLULAR_USAGE_STATE_PATH from EDGEWATCH_DEVICE_ID.
CELLULAR_MODEM_POLL_INTERVAL_S=300
CELLULAR_USAGE_POLL_INTERVAL_S=300

# Default fleet LTE profile (override for another carrier).
BOOTSTRAP_LTE_APN=hologram
# BOOTSTRAP_LTE_USERNAME=
# BOOTSTRAP_LTE_PASSWORD=

# Optional Tailscale overlay. The stock fleet-image-v1 does not install
# Tailscale; requesting enrollment is deliberately fatal unless your customized
# image installs the tailscale CLI and tailscaled first.
# BOOTSTRAP_TAILSCALE_AUTH_KEY=tskey-auth-...
# BOOTSTRAP_TAILSCALE_HOSTNAME=rpi-001
# BOOTSTRAP_TAILSCALE_ENABLE_SSH=false

# Role-specific production profiles
#
# The reusable image writes exactly one of standalone, gateway, or
# camera-satellite to BOOTSTRAP_IMAGE_PROFILE_PATH. A different provisioning
# role is rejected before any device state changes. Every production profile
# requires the OTA trust anchor above.
#
# Gateway: keep the Telegram telemetry settings/token and operator SSH key
# above, but the controller SSH key is intentionally optional. The guided
# Telegram control initialization generates that key later. All five private
# inputs below must be regular mode-0600 files. The adapter executable named by
# the radio ingress file is installed and pinned separately; first boot remains
# incomplete until it proves concentrator and ChirpStack bridge readiness.
# BOOTSTRAP_PROFILE=gateway
# BOOTSTRAP_GATEWAY_RADIO_STATE_DIR=/var/lib/edgewatch-gateway
# BOOTSTRAP_LORAWAN_GATEWAY_CONFIG_FILE=/boot/firmware/edgewatch/lorawan-gateway.yaml
# BOOTSTRAP_LORAWAN_REGISTRY_FILE=/boot/firmware/edgewatch/lorawan-registry.yaml
# BOOTSTRAP_LORAWAN_RADIO_INGRESS_FILE=/boot/firmware/edgewatch/lorawan-radio-ingress.yaml
# BOOTSTRAP_LORAWAN_VENDOR_CONFIG_FILE=/boot/firmware/edgewatch/sx1302-adapter.yaml
# BOOTSTRAP_GATEWAY_POWER_ENV_FILE=/boot/firmware/edgewatch/gateway-power.env
#
# Camera satellite: remove every Telegram, API, cellular, and LTE setting from
# this standalone example and set EDGEWATCH_TELEMETRY_TRANSPORT=none. The
# gateway-generated controller public key is required and is installed only as
# a forced typed-helper key; an operator key is optional. Runtime, RTSP
# credential, and initial signed model bundle inputs are mode 0600. Model and
# OTA public keys are distinct trust anchors. The initial signed model bundle is
# mandatory so zero-touch first boot can always reach camera readiness.
# BOOTSTRAP_PROFILE=camera-satellite
# BOOTSTRAP_AGENT_ENV_PATH=/etc/edgewatch/agent.env
# EDGEWATCH_TELEMETRY_TRANSPORT=none
# EDGEWATCH_OTA_GATEWAY_CACHE_URL=http://10.42.0.1:8091
# EDGEWATCH_ENABLE_OTA_APPLY=false
# EDGEWATCH_OTA_RUNTIME_PROFILE=camera-satellite
# EDGEWATCH_POWER_STATE_PATH=/var/lib/edgewatch-camera-satellite/ota-power-state.json
# EDGEWATCH_ASSET_BUNDLE_APPLY_CMD='/opt/edgewatch/app/.venv/bin/python /opt/edgewatch/current/scripts/apply_model_bundle.py'
# BOOTSTRAP_CONTROL_SSH_AUTHORIZED_KEY_FILE=/boot/firmware/edgewatch/control_authorized_key
# BOOTSTRAP_CAMERA_RUNTIME_ENV_FILE=/boot/firmware/edgewatch/camera-satellite.env
# BOOTSTRAP_CAMERA_CREDENTIALS_FILE=/boot/firmware/edgewatch/camera-rtsp-credentials.json
# BOOTSTRAP_MODEL_PUBLIC_KEY_FILE=/boot/firmware/edgewatch/model_keys/edgewatch-models.pem
# BOOTSTRAP_MODEL_PUBLIC_KEY_ID=edgewatch-models
# BOOTSTRAP_INITIAL_MODEL_BUNDLE_FILE=/boot/firmware/edgewatch/initial-model.tar.gz
#
# MCU HALT_ACK/power-latch firmware and Wio-E5 OTAA/radio programming remain
# external pilot boundaries and are not declared complete by Linux bootstrap.
