# Copy to /etc/edgewatch-controller/gateway-power.env after hardware qualification.
# `observe` validates scheduling but does not save modem energy.
EDGEWATCH_GATEWAY_LTE_POWER_MODE=observe
EDGEWATCH_GATEWAY_LTE_WINDOW_INTERVAL_S=3600
EDGEWATCH_GATEWAY_LTE_MIN_WINDOW_S=60
EDGEWATCH_GATEWAY_LTE_MAX_WINDOW_S=300
# OTA/control holds may extend a window, but never beyond this hard ceiling.
EDGEWATCH_GATEWAY_LTE_MAX_HELD_WINDOW_S=14400
EDGEWATCH_GATEWAY_LTE_TRANSITION_TIMEOUT_S=120
EDGEWATCH_GATEWAY_LTE_TRIGGER_PATH=/var/lib/edgewatch-gateway/lte-trigger.json
EDGEWATCH_GATEWAY_LTE_POWER_STATE_PATH=/var/lib/edgewatch-gateway/lte-power-state.json
EDGEWATCH_GATEWAY_LTE_HOLD_DIR=/var/lib/edgewatch-gateway/lte-holds
CELLULAR_INTERFACE=wwan0

# Optional hosted dead-man check. The URL is a secret capability stored in a
# root/controller-readable 0600 file and never placed directly in this env.
# EDGEWATCH_DEADMAN_HEARTBEAT_URL_FILE=/etc/edgewatch-controller/deadman_url
# EDGEWATCH_DEADMAN_INTERVAL_S=3600
