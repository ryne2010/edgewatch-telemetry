[Unit]
Description=Apply the qualified EdgeWatch LTE modem power-off transition
ConditionPathIsExecutable=/usr/local/libexec/edgewatch-lte-power-off

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/edgewatch-lte-power-off
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
