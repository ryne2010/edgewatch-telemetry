env:
  SOURCE_DATE_EPOCH: @SOURCE_DATE_EPOCH@

device:
  layer: @DEVICE_LAYER@
  hostname: edgewatch-unprovisioned
  user1: ryne
  user1sudo: nopasswd

image:
  layer: image-rpios
  boot_part_size: 200%
  root_part_size: 400%
  name: @IMAGE_NAME@

layer:
  base: bookworm-minbase
  edgewatch: edgewatch-fleet-v1
  profile: @PROFILE_LAYER@

ssh:
  pubkey_only: y
