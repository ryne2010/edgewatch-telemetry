# EdgeWatch agent config

# Telemetry delivery. "api" is the backwards-compatible default; the URL and
# device token below are required only for API transport.
EDGEWATCH_TELEMETRY_TRANSPORT=api

EDGEWATCH_API_URL=http://localhost:8082
EDGEWATCH_DEVICE_ID=baxter-1
EDGEWATCH_DEVICE_TOKEN=dev-device-token-001

# Telegram-exclusive alternative (EDGEWATCH_API_URL/TOKEN are not used):
# - Add the bot to the destination channel as an admin that may post messages.
# - Prefer a root/user-readable token file over putting the token in this env file.
# EDGEWATCH_TELEMETRY_TRANSPORT=telegram
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_BOT_TOKEN_FILE=/var/lib/edgewatch/telegram_bot_token
# TELEGRAM_TIMEOUT_S=10
# TELEGRAM_DISABLE_NOTIFICATION=false
# TELEGRAM_PROTECT_CONTENT=true
# Routine telemetry is grouped as deterministic gzip JSONL. The current
# startup/heartbeat/alert point sends directly; a heartbeat may then flush at
# most one routine-budgeted partial backlog batch.
# TELEGRAM_BATCH_ENABLED=true
# TELEGRAM_BATCH_MAX_POINTS=100
# TELEGRAM_BATCH_MAX_BYTES=1000000
# TELEGRAM_BATCH_MAX_AGE_S=3600

# Sensor backend controls
# - Default backend is mock when SENSOR_CONFIG_PATH is not set.
# - SENSOR_BACKEND overrides the backend selected in the YAML file.
# - Use none for hardware-free device/network bring-up (no synthetic metrics).
# SENSOR_CONFIG_PATH=./agent/config/example.sensors.yaml
# SENSOR_BACKEND=mock
# SENSOR_BACKEND=none
#
# Raspberry Pi BME280 example:
# SENSOR_BACKEND=rpi_i2c
# (requires `pip install smbus2`)
#
# Raspberry Pi ADS1115 example:
# SENSOR_BACKEND=rpi_adc
# (requires `pip install smbus2`)
#
# Raspberry Pi microphone example:
# SENSOR_BACKEND=rpi_microphone
# (requires `arecord` from `alsa-utils`)
#
# Derived oil-life model example:
# SENSOR_BACKEND=derived
# (configure state_path/oil_life_max_run_hours in SENSOR_CONFIG_PATH YAML)

# Cellular observability (Task 13b)
# Keep disabled on laptops/CI; enable on Pi nodes with ModemManager.
# CELLULAR_METRICS_ENABLED=false
# CELLULAR_MODEM_ID=0
# CELLULAR_MMCLI_TIMEOUT_S=3
# CELLULAR_MODEM_POLL_INTERVAL_S=60
#
# Link watchdog (cheap DNS + HTTP checks); off by default to avoid probe traffic.
# CELLULAR_WATCHDOG_ENABLED=false
# CELLULAR_WATCHDOG_INTERVAL_S=60
# CELLULAR_WATCHDOG_DNS_HOST=www.gstatic.com
# CELLULAR_WATCHDOG_HTTP_URL=https://www.gstatic.com/generate_204
# CELLULAR_WATCHDOG_TIMEOUT_S=2.5
#
# Daily usage counters (best effort via /sys/class/net/<iface>/statistics)
# CELLULAR_INTERFACE=wwan0
# CELLULAR_USAGE_POLL_INTERVAL_S=60
# Persist this state on field nodes. Actual interface TX totals are preferred
# for daily byte-cap enforcement when available.
# CELLULAR_USAGE_STATE_PATH=/var/lib/edgewatch/cellular_usage_baxter-1.json

# Durable daily counters used for edge policy cost-cap enforcement.
# Default includes device id in path.
# EDGEWATCH_COST_CAP_STATE_PATH=./edgewatch_cost_caps_baxter-1.json

# Cache the last-known device policy (ETag + payload)
# Default is device-specific: ./edgewatch_policy_cache_<device_id>.json
# EDGEWATCH_POLICY_CACHE_PATH=./edgewatch_policy_cache_baxter-1.json

# Durable state for power-management rolling windows.
# Default is device-specific: ./edgewatch_power_state_<device_id>.json
# EDGEWATCH_POWER_STATE_PATH=./edgewatch_power_state_baxter-1.json

# Hybrid disable mode:
# - Default logical disable (no remote shutdown side effects).
# - Set to 1 only on nodes where remote OS shutdown is explicitly allowed.
# EDGEWATCH_ALLOW_REMOTE_SHUTDOWN=0
# Optional override command; default is "sudo shutdown -h now".
# EDGEWATCH_REMOTE_SHUTDOWN_CMD="sudo shutdown -h now"

# OTA update execution:
# - Policy may carry pending_update_command when ENABLE_OTA_UPDATES=1 on API.
# - Keep apply disabled by default (dry-run report mode).
# - Enable only after pilot validation.
# EDGEWATCH_ENABLE_OTA_APPLY=0
# Optional update-state file path (default includes device id):
# EDGEWATCH_UPDATE_STATE_PATH=./edgewatch_update_state_baxter-1.json
# Optional repository/update paths for apply mode:
# EDGEWATCH_REPO_DIR=/opt/edgewatch/repo
# EDGEWATCH_RELEASES_ROOT=/opt/edgewatch/releases
# EDGEWATCH_CURRENT_SYMLINK=/opt/edgewatch/current
# Application OTA is code-only until dependency-aware activation is qualified.
# The signed release fingerprint must match this installed requirements file.
# EDGEWATCH_RUNTIME_DEPENDENCY_PATH=/opt/edgewatch/current/agent/requirements.txt
# Fresh power evidence is required before OTA stage/apply on Raspberry Pi.
# EDGEWATCH_OTA_POWER_EVIDENCE_MAX_AGE_S=300

# Media capture (Task 12a)
# Enable scheduled snapshots into a local ring buffer.
# MEDIA_ENABLED=false
# CAMERA_IDS=cam1
# MEDIA_SNAPSHOT_INTERVAL_S=300
# MEDIA_CAPTURE_RETRY_S=60
# MEDIA_UPLOAD_RETRY_S=60
# MEDIA_UPLOAD_BACKOFF_MAX_S=300
# MEDIA_UPLOAD_TIMEOUT_S=20
# MEDIA_ALERT_TRANSITION_MIN_INTERVAL_S=30
# MEDIA_RING_DIR=./edgewatch_media
# MEDIA_RING_MAX_BYTES=524288000
# MEDIA_CAPTURE_TIMEOUT_S=15
# MEDIA_CAPTURE_LOCK_TIMEOUT_S=5

# Local buffer (SQLite) for offline operation
BUFFER_DB_PATH=./edgewatch_buffer.sqlite
# Optional hardening controls:
# - DB size quota in bytes (oldest queued points are evicted first when exceeded)
# - WAL + pragmas for better crash resilience on edge hardware
# - batch size controls how many rows to evict per quota/disk-full event
# - corruption recovery moves malformed DB files aside and recreates schema
# BUFFER_MAX_DB_BYTES=104857600
# BUFFER_SQLITE_JOURNAL_MODE=WAL
# NORMAL is faster; fleet-image-v1 provisions FULL for sudden-power-loss safety.
# BUFFER_SQLITE_SYNCHRONOUS=FULL
# BUFFER_SQLITE_TEMP_STORE=MEMORY
# BUFFER_EVICTION_BATCH_SIZE=100
# BUFFER_RECOVER_CORRUPTION=true

# Optional: write "poison" telemetry points (validation errors) here so they
# don't block buffer flush. Oversized Telegram points are preserved here.
# EDGEWATCH_DEADLETTER_PATH=./edgewatch_deadletter_demo-well-001.jsonl

# -----------------------------------------------------------------------------
# Local/fallback policy. Used whenever the API policy cannot be fetched and is
# the authoritative configuration in Telegram-exclusive mode.
# In API mode, tune contracts/edge_policy/v1.yaml instead.
# -----------------------------------------------------------------------------

SAMPLE_INTERVAL_S=600
ALERT_SAMPLE_INTERVAL_S=600
HEARTBEAT_INTERVAL_S=600
ALERT_REPORT_INTERVAL_S=600

MAX_POINTS_PER_BATCH=50
BUFFER_MAX_POINTS=5000
BUFFER_MAX_AGE_S=604800

BACKOFF_INITIAL_S=5
BACKOFF_MAX_S=300

MICROPHONE_OFFLINE_DB=60.0
WATER_PRESSURE_LOW_PSI=30.0
WATER_PRESSURE_RECOVER_PSI=32.0

BATTERY_LOW_V=11.8
BATTERY_RECOVER_V=12.0

SIGNAL_LOW_RSSI_DBM=-95
SIGNAL_RECOVER_RSSI_DBM=-90

# Cost caps fallback (used only when /api/v1/device-policy cannot be fetched).
MAX_BYTES_PER_DAY=50000000
# Separately bounded urgent startup/heartbeat/state/alert reserve (256 KiB/day).
EDGEWATCH_COST_CAP_URGENT_RESERVE_BYTES=262144
MAX_SNAPSHOTS_PER_DAY=48
MAX_MEDIA_UPLOADS_PER_DAY=48

POWER_MGMT_ENABLED=true
POWER_MGMT_MODE=dual
POWER_INPUT_WARN_MIN_V=11.8
POWER_INPUT_WARN_MAX_V=14.8
POWER_INPUT_CRITICAL_MIN_V=11.4
POWER_INPUT_CRITICAL_MAX_V=15.2
POWER_SUSTAINABLE_INPUT_W=15.0
POWER_UNSUSTAINABLE_WINDOW_S=900
POWER_BATTERY_TREND_WINDOW_S=1800
POWER_BATTERY_DROP_WARN_V=0.25
POWER_SAVER_SAMPLE_INTERVAL_S=1200
POWER_SAVER_HEARTBEAT_INTERVAL_S=1800
POWER_MEDIA_DISABLED_IN_SAVER=true

DELTA_MICROPHONE_LEVEL_DB=1.0
DELTA_POWER_INPUT_V=0.1
DELTA_POWER_INPUT_A=0.1
DELTA_POWER_INPUT_W=0.5
DELTA_WATER_PRESSURE_PSI=1.0
DELTA_OIL_PRESSURE_PSI=1.0
DELTA_TEMPERATURE_C=0.5
DELTA_BATTERY_V=0.05
DELTA_SIGNAL_RSSI_DBM=2
